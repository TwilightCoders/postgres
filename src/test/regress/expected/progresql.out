--
-- ProgreSQL: cross-partition (spanning) PRIMARY KEY / UNIQUE via GLOBAL
--
-- A PRIMARY KEY / UNIQUE declared GLOBAL on a partitioned root whose columns
-- don't match the partition key is implemented as a "spanning index": a real
-- btree on the root storing (key_cols..., partseq) entries that enforce
-- cross-partition uniqueness via indnuniqatts in pg_index.  GLOBAL is the sole
-- opt-in; ordinary partitioned tables behave exactly like stock PostgreSQL.
--
-- Section 1: Basic table creation with GLOBAL
CREATE TABLE progresql_data (
    id      bigint,
    kind    text,
    ts      timestamptz NOT NULL,
    PRIMARY KEY (id) GLOBAL,      -- not the partition key
    CHECK (ts IS NOT NULL)
) PARTITION BY RANGE (ts);
-- Section 2: Spanning index catalog state
-- indnuniqatts=1 (just id), indnkeyatts=2 (id + partseq discriminator col)
SELECT indnuniqatts, indnkeyatts, indnatts
FROM pg_index
WHERE indrelid = 'progresql_data'::regclass
  AND indisprimary;
 indnuniqatts | indnkeyatts | indnatts 
--------------+-------------+----------
            1 |           2 |        2
(1 row)

-- Section 3: Add partitions
CREATE TABLE progresql_data_2024
    PARTITION OF progresql_data (ts NOT NULL)
    FOR VALUES FROM ('2024-01-01') TO ('2025-01-01');
CREATE TABLE progresql_data_2025
    PARTITION OF progresql_data (ts NOT NULL)
    FOR VALUES FROM ('2025-01-01') TO ('2026-01-01');
-- Section 4: Basic inserts across partitions
INSERT INTO progresql_data VALUES (1, 'alpha', '2024-06-15 00:00:00+00');
INSERT INTO progresql_data VALUES (2, 'beta',  '2025-03-10 00:00:00+00');
SELECT id, kind FROM progresql_data ORDER BY id;
 id | kind  
----+-------
  1 | alpha
  2 | beta
(2 rows)

-- Section 5: Same-partition PK duplicate is rejected
BEGIN;
INSERT INTO progresql_data VALUES (1, 'dup', '2024-09-01 00:00:00+00');
ERROR:  duplicate key value violates unique constraint "progresql_data_pkey"
DETAIL:  Key (id)=(1) already exists.
ROLLBACK;
-- Section 6: Cross-partition PK duplicate is rejected
-- id=1 is in 2024 partition; try inserting id=1 into 2025 partition
BEGIN;
INSERT INTO progresql_data VALUES (1, 'crossdup', '2025-06-01 00:00:00+00');
ERROR:  duplicate key value violates unique constraint "progresql_data_pkey"
DETAIL:  Key (id)=(1) already exists.
ROLLBACK;
-- Section 7: DELETE then reinsert same key succeeds
DELETE FROM progresql_data WHERE id = 1;
INSERT INTO progresql_data VALUES (1, 'reinsert', '2024-11-01 00:00:00+00');
SELECT id, kind FROM progresql_data WHERE id = 1;
 id |   kind   
----+----------
  1 | reinsert
(1 row)

-- Section 8: UPDATE key column (moves the spanning index entry)
UPDATE progresql_data SET id = 99 WHERE id = 2;
SELECT id, kind FROM progresql_data ORDER BY id;
 id |   kind   
----+----------
  1 | reinsert
 99 | beta
(2 rows)

-- Duplicate after update is rejected
BEGIN;
UPDATE progresql_data SET id = 99 WHERE id = 1;
ERROR:  duplicate key value violates unique constraint "progresql_data_pkey"
DETAIL:  Key (id)=(99) already exists.
ROLLBACK;
-- Section 9: Normal indexes still have indnuniqatts = 0
CREATE TABLE progresql_normal (a int PRIMARY KEY, b int);
SELECT indnuniqatts, indnkeyatts
FROM pg_index
WHERE indrelid = 'progresql_normal'::regclass AND indisprimary;
 indnuniqatts | indnkeyatts 
--------------+-------------
            0 |           1
(1 row)

DROP TABLE progresql_normal;
-- Section 10: UNIQUE (not just PK) also gets a spanning index
ALTER TABLE progresql_data ADD CONSTRAINT progresql_data_kind_uniq UNIQUE (kind) GLOBAL;
SELECT indnuniqatts, indnkeyatts
FROM pg_index
WHERE indrelid = 'progresql_data'::regclass
  AND NOT indisprimary
  AND indisunique;
 indnuniqatts | indnkeyatts 
--------------+-------------
            1 |           2
(1 row)

-- Reject cross-partition kind duplicate
BEGIN;
INSERT INTO progresql_data VALUES (50, 'reinsert', '2025-07-01 00:00:00+00');
ERROR:  duplicate key value violates unique constraint "progresql_data_kind_uniq"
DETAIL:  Key (kind)=(reinsert) already exists.
ROLLBACK;
-- Section 11: TRUNCATE partition clears spanning index
-- After truncating 2024, id=1 should be gone
TRUNCATE progresql_data_2024;
SELECT count(*) FROM progresql_data WHERE id = 1;  -- should be 0
 count 
-------
     0
(1 row)

-- And id=1 should now be insertable (spanning index cleaned up)
INSERT INTO progresql_data VALUES (1, 'after_truncate', '2024-02-01 00:00:00+00');
SELECT id, kind FROM progresql_data WHERE id = 1;
 id |      kind      
----+----------------
  1 | after_truncate
(1 row)

-- Section 12: without GLOBAL, a partitioned UNIQUE/PK still enforces the
-- old "must include the partition key" rule.
CREATE TABLE partonly (a int, b int) PARTITION BY RANGE (b);
CREATE UNIQUE INDEX ON partonly (a);  -- should fail: a not in partition key
ERROR:  unique constraint on partitioned table must include all partitioning columns
DETAIL:  UNIQUE constraint on table "partonly" lacks column "b" which is part of the partition key.
DROP TABLE partonly;
-- Section 13: the legacy implicit handshake is retired -- a partitioned table
-- can no longer also INHERITS a base table (vanilla PostgreSQL behavior); the
-- only way to get a spanning index is the explicit GLOBAL keyword.
CREATE TABLE legacy_base (id bigint, ts timestamptz NOT NULL);
CREATE TABLE legacy (PRIMARY KEY (id)) INHERITS (legacy_base)
  PARTITION BY RANGE (ts);            -- ERROR: cannot create partitioned table
ERROR:  cannot create partitioned table as inheritance child
                                      --        as inheritance child
DROP TABLE legacy_base;
-- Section 14: spanning indexes and multi-level partitioning.
-- A GLOBAL index built on a PRE-EXISTING multi-level tree is supported: the
-- build enumerates every storage-bearing leaf at any depth (find_all_inheritors)
-- and enforces uniqueness across them.  Only DYNAMIC sub-partitioning of an
-- already-spanning-indexed root is rejected (its new sub-leaves would have no
-- partseq and silently escape the index).
-- (a) cannot sub-partition a partition of a spanning-indexed root
CREATE TABLE ml1 (id bigint NOT NULL, region text NOT NULL, ts timestamptz NOT NULL,
    PRIMARY KEY (id) GLOBAL) PARTITION BY LIST (region);
CREATE TABLE ml1_us PARTITION OF ml1 FOR VALUES IN ('us')
    PARTITION BY RANGE (ts);            -- ERROR: cannot sub-partition
ERROR:  cannot sub-partition a partition of a table with a spanning (GLOBAL) index
DETAIL:  Spanning index "ml1_pkey" does not support multi-level partitioning; every partition must be a leaf.
DROP TABLE ml1;
-- (b) a GLOBAL index built on a PRE-EXISTING multi-level tree IS supported:
-- the build spans every grandchild leaf and enforces uniqueness across them.
CREATE TABLE ml2 (id bigint NOT NULL, region text NOT NULL, ts timestamptz NOT NULL)
    PARTITION BY LIST (region);
CREATE TABLE ml2_us PARTITION OF ml2 FOR VALUES IN ('us') PARTITION BY RANGE (ts);
CREATE TABLE ml2_us_2024 PARTITION OF ml2_us
    FOR VALUES FROM ('2024-01-01') TO ('2025-01-01');
CREATE TABLE ml2_us_2025 PARTITION OF ml2_us
    FOR VALUES FROM ('2025-01-01') TO ('2026-01-01');
INSERT INTO ml2 VALUES (1, 'us', '2024-06-01');
CREATE UNIQUE INDEX ON ml2 (id) GLOBAL;   -- supported: spans grandchild leaves
INSERT INTO ml2 VALUES (1, 'us', '2025-06-01');  -- ERROR: dup id across sub-partitions
ERROR:  duplicate key value violates unique constraint "ml2_id_idx"
DETAIL:  Key (id)=(1) already exists.
INSERT INTO ml2 VALUES (2, 'us', '2025-06-01');  -- ok
DROP TABLE ml2;
-- Section 15: INSERT ... ON CONFLICT is unsupported on a spanning index -- the
-- arbiter-inference path cannot see the root's spanning index from a leaf -- so
-- it FAILS CLOSED with a clear error, never silently bypassing cross-partition
-- uniqueness.  MERGE (which matches by scanning all partitions) works, and its
-- inserts still flow through the uniqueness-enforced path.
CREATE TABLE oc (id bigint NOT NULL, v text, ts timestamptz NOT NULL,
    PRIMARY KEY (id) GLOBAL) PARTITION BY RANGE (ts);
CREATE TABLE oc1 PARTITION OF oc FOR VALUES FROM ('2024-01-01') TO ('2025-01-01');
CREATE TABLE oc2 PARTITION OF oc FOR VALUES FROM ('2025-01-01') TO ('2026-01-01');
INSERT INTO oc VALUES (1, 'a', '2024-06-01');
INSERT INTO oc VALUES (1, 'b', '2025-06-01')
  ON CONFLICT (id) DO NOTHING;             -- ERROR: no matching arbiter
ERROR:  there is no unique or exclusion constraint matching the ON CONFLICT specification
INSERT INTO oc VALUES (1, 'c', '2025-06-01')
  ON CONFLICT (id) DO UPDATE SET v = 'x';  -- ERROR: no matching arbiter
ERROR:  there is no unique or exclusion constraint matching the ON CONFLICT specification
MERGE INTO oc t USING (SELECT 1 AS id) s ON t.id = s.id
  WHEN MATCHED THEN UPDATE SET v = 'm'
  WHEN NOT MATCHED THEN INSERT VALUES (1, 'm', '2025-06-01');
SELECT id, v FROM oc ORDER BY id;          -- id=1, v=m (matched + updated)
 id | v 
----+---
  1 | m
(1 row)

INSERT INTO oc VALUES (1, 'dup', '2025-08-01');  -- ERROR: duplicate key (id)=(1)
ERROR:  duplicate key value violates unique constraint "oc_pkey"
DETAIL:  Key (id)=(1) already exists.
DROP TABLE oc;
-- Cleanup
DROP TABLE progresql_data;

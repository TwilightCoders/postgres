--
-- progsql_shadow: cross-partition uniqueness via shadow index
--
-- The shadow table for a constraint is named "_pss_<indexOid>" and its
-- UNIQUE constraint is "_pss_<indexOid>_key", so any error message
-- mentioning those names is OID-volatile.  We trap the unique-violation
-- inside DO blocks and emit a stable substitute message instead.
\set VERBOSITY terse
CREATE TABLE pss_base (kind text NOT NULL);
CREATE TABLE pss_messages (
    id      uuid    NOT NULL DEFAULT gen_random_uuid(),
    kind    text    NOT NULL DEFAULT 'message',
    content text,
    PRIMARY KEY (id)
) INHERITS (pss_base) PARTITION BY LIST (kind);
NOTICE:  moving and merging column "kind" with inherited definition
CREATE TABLE pss_messages_msg  PARTITION OF pss_messages FOR VALUES IN ('message');
CREATE TABLE pss_messages_note PARTITION OF pss_messages FOR VALUES IN ('note');
-- A shadow entry should exist for the partitioned root.
SELECT count(*) AS shadow_entries
  FROM pg_progsql_shadow s
  JOIN pg_class c ON s.pssrootrelid = c.oid
 WHERE c.relname = 'pss_messages';
 shadow_entries 
----------------
              1
(1 row)

-- Insert into first partition should succeed
INSERT INTO pss_messages (id, kind, content)
    VALUES ('11111111-1111-7111-8111-111111111111', 'message', 'hello');
-- Duplicate PK in same partition must fail with a unique_violation.
DO $$
BEGIN
    INSERT INTO pss_messages (id, kind, content)
        VALUES ('11111111-1111-7111-8111-111111111111', 'message', 'dup same');
    RAISE NOTICE 'duplicate same-partition: NO error (unexpected)';
EXCEPTION WHEN unique_violation THEN
    RAISE NOTICE 'duplicate same-partition: unique_violation (expected)';
END $$;
NOTICE:  duplicate same-partition: unique_violation (expected)
-- Duplicate PK across partitions must also fail.
DO $$
BEGIN
    INSERT INTO pss_messages (id, kind, content)
        VALUES ('11111111-1111-7111-8111-111111111111', 'note', 'dup cross');
    RAISE NOTICE 'duplicate cross-partition: NO error (unexpected)';
EXCEPTION WHEN unique_violation THEN
    RAISE NOTICE 'duplicate cross-partition: unique_violation (expected)';
END $$;
NOTICE:  duplicate cross-partition: unique_violation (expected)
-- Different PK across partitions is fine
INSERT INTO pss_messages (id, kind, content)
    VALUES ('22222222-2222-7222-8222-222222222222', 'note', 'ok');
SELECT id, kind, content FROM pss_messages ORDER BY id;
                  id                  |  kind   | content 
--------------------------------------+---------+---------
 11111111-1111-7111-8111-111111111111 | message | hello
 22222222-2222-7222-8222-222222222222 | note    | ok
(2 rows)

-- ------------------------------------------------------------------
-- Gap 1: DELETE removes shadow row, allowing re-insertion of same key
-- ------------------------------------------------------------------
INSERT INTO pss_messages (id, kind, content)
    VALUES ('33333333-3333-7333-8333-333333333333', 'message', 'to delete');
-- Same id is now blocked
DO $$
BEGIN
    INSERT INTO pss_messages (id, kind, content)
        VALUES ('33333333-3333-7333-8333-333333333333', 'note', 'pre-delete dup');
    RAISE NOTICE 'pre-delete dup: NO error (unexpected)';
EXCEPTION WHEN unique_violation THEN
    RAISE NOTICE 'pre-delete dup: unique_violation (expected)';
END $$;
NOTICE:  pre-delete dup: unique_violation (expected)
DELETE FROM pss_messages WHERE id = '33333333-3333-7333-8333-333333333333';
-- After delete the same id can be inserted again (and across partitions).
INSERT INTO pss_messages (id, kind, content)
    VALUES ('33333333-3333-7333-8333-333333333333', 'note', 're-inserted after delete');
SELECT id, kind, content FROM pss_messages ORDER BY id;
                  id                  |  kind   |         content          
--------------------------------------+---------+--------------------------
 11111111-1111-7111-8111-111111111111 | message | hello
 22222222-2222-7222-8222-222222222222 | note    | ok
 33333333-3333-7333-8333-333333333333 | note    | re-inserted after delete
(3 rows)

-- ------------------------------------------------------------------
-- Gap 2a: UPDATE that does NOT touch a key column does not affect shadow
-- ------------------------------------------------------------------
UPDATE pss_messages SET content = 'updated content'
    WHERE id = '11111111-1111-7111-8111-111111111111';
-- The same id should still be blocked across partitions: shadow is intact.
DO $$
BEGIN
    INSERT INTO pss_messages (id, kind, content)
        VALUES ('11111111-1111-7111-8111-111111111111', 'note', 'should still dup');
    RAISE NOTICE 'post-non-key-update dup: NO error (unexpected)';
EXCEPTION WHEN unique_violation THEN
    RAISE NOTICE 'post-non-key-update dup: unique_violation (expected)';
END $$;
NOTICE:  post-non-key-update dup: unique_violation (expected)
-- ------------------------------------------------------------------
-- Gap 2b: UPDATE that DOES change the key column must move the shadow row
-- ------------------------------------------------------------------
-- Updating the id (key column) within the same partition.
UPDATE pss_messages SET id = '44444444-4444-7444-8444-444444444444'
    WHERE id = '22222222-2222-7222-8222-222222222222';
-- The old id is now free for re-use; the new id must be blocked.
INSERT INTO pss_messages (id, kind, content)
    VALUES ('22222222-2222-7222-8222-222222222222', 'message', 'old key reused');
DO $$
BEGIN
    INSERT INTO pss_messages (id, kind, content)
        VALUES ('44444444-4444-7444-8444-444444444444', 'message', 'new key dup');
    RAISE NOTICE 'post-key-update dup: NO error (unexpected)';
EXCEPTION WHEN unique_violation THEN
    RAISE NOTICE 'post-key-update dup: unique_violation (expected)';
END $$;
NOTICE:  post-key-update dup: unique_violation (expected)
SELECT id, kind, content FROM pss_messages ORDER BY id;
                  id                  |  kind   |         content          
--------------------------------------+---------+--------------------------
 11111111-1111-7111-8111-111111111111 | message | updated content
 22222222-2222-7222-8222-222222222222 | message | old key reused
 33333333-3333-7333-8333-333333333333 | note    | re-inserted after delete
 44444444-4444-7444-8444-444444444444 | note    | ok
(4 rows)

-- ------------------------------------------------------------------
-- Gap 3: TRUNCATE clears the shadow appropriately
-- ------------------------------------------------------------------
-- Count before truncate (just to anchor the test reading)
SELECT count(*) AS before_truncate FROM pg_progsql_shadow s
    JOIN pg_class c ON s.pssrootrelid = c.oid
   WHERE c.relname = 'pss_messages';
 before_truncate 
-----------------
               1
(1 row)

-- Truncate only the 'message' partition.  Shadow rows for that partition
-- should disappear; rows belonging to the 'note' partition remain.
TRUNCATE pss_messages_msg;
SELECT count(*) AS rows_in_root FROM pss_messages;
 rows_in_root 
--------------
            2
(1 row)

-- Now we can insert any 'message'-partition row, including ids previously
-- present in pss_messages_msg.
INSERT INTO pss_messages (id, kind, content)
    VALUES ('22222222-2222-7222-8222-222222222222', 'message', 'reusing after truncate');
-- But cross-partition shadow on remaining 'note' rows is still enforced.
DO $$
BEGIN
    INSERT INTO pss_messages (id, kind, content)
        VALUES ('33333333-3333-7333-8333-333333333333', 'message', 'still dup with note row');
    RAISE NOTICE 'partition-truncate cross-dup: NO error (unexpected)';
EXCEPTION WHEN unique_violation THEN
    RAISE NOTICE 'partition-truncate cross-dup: unique_violation (expected)';
END $$;
NOTICE:  partition-truncate cross-dup: unique_violation (expected)
-- Truncate the root table: shadow must be entirely cleared.
TRUNCATE pss_messages;
SELECT count(*) AS rows_after_root_truncate FROM pss_messages;
 rows_after_root_truncate 
--------------------------
                        0
(1 row)

-- After full truncate, all keys should be free again.  The first INSERT
-- succeeds; the second is a cross-partition duplicate against the first
-- and must still fail, demonstrating the shadow is rebuilt as we insert.
INSERT INTO pss_messages (id, kind, content)
    VALUES ('11111111-1111-7111-8111-111111111111', 'message', 'fresh after truncate');
DO $$
BEGIN
    INSERT INTO pss_messages (id, kind, content)
        VALUES ('11111111-1111-7111-8111-111111111111', 'note', 'cross-dup post-truncate');
    RAISE NOTICE 'post-truncate cross-dup: NO error (unexpected)';
EXCEPTION WHEN unique_violation THEN
    RAISE NOTICE 'post-truncate cross-dup: unique_violation (expected)';
END $$;
NOTICE:  post-truncate cross-dup: unique_violation (expected)
SELECT id, kind, content FROM pss_messages ORDER BY id, kind;
                  id                  |  kind   |       content        
--------------------------------------+---------+----------------------
 11111111-1111-7111-8111-111111111111 | message | fresh after truncate
(1 row)

-- ------------------------------------------------------------------
-- Gap 4: Deferred PK constraint propagates DEFERRABLE INITIALLY DEFERRED
--        to the shadow's UNIQUE constraint
-- ------------------------------------------------------------------
CREATE TABLE pss_def_base (kind text NOT NULL);
CREATE TABLE pss_def (
    id      int   NOT NULL,
    kind    text  NOT NULL DEFAULT 'a',
    payload text,
    CONSTRAINT pss_def_pk PRIMARY KEY (id) DEFERRABLE INITIALLY DEFERRED
) INHERITS (pss_def_base) PARTITION BY LIST (kind);
NOTICE:  moving and merging column "kind" with inherited definition
CREATE TABLE pss_def_a PARTITION OF pss_def FOR VALUES IN ('a');
CREATE TABLE pss_def_b PARTITION OF pss_def FOR VALUES IN ('b');
-- Verify the shadow's UNIQUE constraint is also DEFERRABLE INITIALLY DEFERRED.
-- (We omit the OID-stamped name and just report the deferral flags.)
SELECT con.condeferrable,
       con.condeferred
  FROM pg_progsql_shadow s
  JOIN pg_class root ON s.pssrootrelid = root.oid
  JOIN pg_constraint con ON con.conrelid = s.pssshadowid
 WHERE root.relname = 'pss_def'
   AND con.contype = 'u';
 condeferrable | condeferred 
---------------+-------------
 t             | t
(1 row)

-- With the constraint deferred, an in-transaction cross-partition duplicate
-- can be temporarily violated and then resolved before commit.
BEGIN;
    INSERT INTO pss_def (id, kind, payload) VALUES (10, 'a', 'first');
    INSERT INTO pss_def (id, kind, payload) VALUES (10, 'b', 'temp dup');
    -- Resolve the violation before commit.
    DELETE FROM pss_def WHERE kind = 'a' AND id = 10;
COMMIT;
SELECT id, kind, payload FROM pss_def ORDER BY id, kind;
 id | kind | payload  
----+------+----------
 10 | b    | temp dup
(1 row)

-- A pair of cross-partition duplicate inserts inside a single block must
-- not fail until the deferred check runs.  We force it via SET CONSTRAINTS
-- ALL IMMEDIATE so we can catch the error inside the DO block (otherwise
-- the error fires at COMMIT and the message contains the shadow OID).
DO $$
BEGIN
    BEGIN
        INSERT INTO pss_def (id, kind, payload) VALUES (30, 'a', 'x');
        INSERT INTO pss_def (id, kind, payload) VALUES (30, 'b', 'y');
        RAISE NOTICE 'deferred pre-immediate: no error yet (expected)';
        -- Force the deferred check to run within this savepoint subtxn.
        SET CONSTRAINTS ALL IMMEDIATE;
        RAISE NOTICE 'deferred SET IMMEDIATE: NO error (unexpected)';
    END;
EXCEPTION WHEN unique_violation THEN
    RAISE NOTICE 'deferred SET IMMEDIATE: unique_violation (expected)';
END $$;
NOTICE:  deferred pre-immediate: no error yet (expected)
NOTICE:  deferred SET IMMEDIATE: unique_violation (expected)
-- Cleanup of the deferred test table.
SET client_min_messages = warning;
DROP TABLE pss_def CASCADE;
DROP TABLE pss_def_base CASCADE;
RESET client_min_messages;
-- ------------------------------------------------------------------
-- Final cleanup of the main table.
-- ------------------------------------------------------------------
-- Avoid printing the cascade NOTICE which mentions the shadow OID.
SET client_min_messages = warning;
DROP TABLE pss_messages CASCADE;
DROP TABLE pss_base CASCADE;
RESET client_min_messages;
-- Confirm the shadow entry is gone.
SELECT count(*) AS shadow_entries_after_drop FROM pg_progsql_shadow;
 shadow_entries_after_drop 
---------------------------
                         0
(1 row)

